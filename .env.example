# Local PostgreSQL (Docker: postgres:17-bookworm)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Seed users (used by prisma/seed.ts)
# Format: "username1:password1,username2:password2"
SEED_USERS="elena:123456,bill:123456"

# S3-compatible object storage (MinIO)
S3_ENDPOINT=http://your-minio-host:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=wth
S3_REGION=us-east-1

# AI Ping (OpenAI-compatible) API key for Chat
# Model: GLM-5.1, baseUrl: https://aiping.cn/api/v1
AIPING_API_KEY=

# Volcano Engine (Doubao) ASR — optional, for voice input
ASR_APP_ID=
ASR_ACCESS_TOKEN=
ASR_API_KEY=
ASR_RESOURCE_ID=
