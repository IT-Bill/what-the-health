generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model chat_messages {
  id            String        @id
  sessionId     String
  role          ChatRole
  content       String
  reasoning     String?
  model         String?
  inputTokens   Int?
  outputTokens  Int?
  createdAt     DateTime      @default(now())
  chat_sessions chat_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model chat_sessions {
  id            String          @id
  userId        String
  title         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  chat_messages chat_messages[]
  users         users           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model goals {
  id                String              @id
  userId            String
  title             String
  description       String?
  icon              String?
  cadence           HabitCadence        @default(daily)
  sortOrder         Int                 @default(0)
  archived          Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  users             users               @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit_completions habit_completions[]

  @@index([userId, archived])
}

model habit_completions {
  id          String   @id
  goalId      String
  userId      String
  completedAt DateTime @default(now())
  forDate     DateTime @db.Date
  goals       goals    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, forDate])
  @@index([userId, forDate])
}

model health_connections {
  id          String           @id
  userId      String
  provider    HealthProvider
  status      ConnectionStatus @default(disconnected)
  connectedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  users       users            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model journeys {
  id           String          @id
  title        String
  quote        String?
  category     JourneyCategory
  categoryIcon String?
  authorName   String
  authorAvatar String?
  coverImage   String?
  readMinutes  Int             @default(5)
  published    Boolean         @default(true)
  publishedAt  DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime

  @@index([category, published])
}

model memories {
  id               String             @id
  userId           String
  note             String?
  prompt           String?
  createdAt        DateTime           @default(now())
  users            users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory_reactions memory_reactions[]

  @@index([userId, createdAt])
}

model memory_reactions {
  id       String       @id
  memoryId String
  type     ReactionType
  memories memories     @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([memoryId, type])
}

model mood_checkins {
  id        String   @id
  userId    String
  mood      Mood
  note      String?
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model products {
  id           String        @id
  name         String
  description  String
  image        String?
  priceCredits Int
  available    Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  redemptions  redemptions[]
}

model redemptions {
  id           String           @id
  userId       String
  productId    String
  creditsSpent Int
  status       RedemptionStatus @default(pending)
  createdAt    DateTime         @default(now())
  products     products         @relation(fields: [productId], references: [id])
  users        users            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model users {
  id                   String               @id
  email                String               @unique
  passwordHash         String?
  name                 String
  avatarUrl            String?
  gender               Gender?
  birthday             DateTime?            @db.Date
  heightCm             Int?
  weightKg             Float?
  memberSince          DateTime             @default(now())
  notificationsEnabled Boolean              @default(true)
  credits              Int                  @default(0)
  primaryGoal          GoalType?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  chat_sessions        chat_sessions[]
  goals                goals[]
  habit_completions    habit_completions[]
  health_connections   health_connections[]
  memories             memories[]
  mood_checkins        mood_checkins[]
  redemptions          redemptions[]
}

enum ChatRole {
  user
  assistant
}

enum ConnectionStatus {
  connected
  disconnected
}

enum Gender {
  female
  male
  nonBinary
  undisclosed
}

enum GoalType {
  buildMuscle
  loseWeight
  healthyHabits
}

enum HabitCadence {
  daily
  weekly
  custom
}

enum HealthProvider {
  appleHealth
  garmin
  oura
}

enum JourneyCategory {
  mindfulness
  nutrition
  reflection
  sleep
}

enum Mood {
  calm
  anxious
  fatigued
}

enum ReactionType {
  inspired
  resonate
  willTry
}

enum RedemptionStatus {
  pending
  fulfilled
  cancelled
}
