// Prisma schema for "Mindful" — Quiet Luxury Wellness app.
// Prisma 7: new `prisma-client` generator + driver adapters (see src/lib/prisma.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Gender {
  female
  male
  nonBinary
  undisclosed
}

/// Mood selected during onboarding / daily check-in (design _1).
enum Mood {
  calm
  anxious
  fatigued
}

/// Primary wellness goal chosen during onboarding (design _7).
enum GoalType {
  buildMuscle
  loseWeight
  healthyHabits
}

/// Cadence at which a habit should recur.
enum HabitCadence {
  daily
  weekly
  custom
}

/// Author role in a chat conversation.
enum ChatRole {
  user
  assistant
}

/// Content category for discover journeys (design _8).
enum JourneyCategory {
  mindfulness
  nutrition
  reflection
  sleep
}

/// Quick reaction on a memory/storyline (design _2).
enum ReactionType {
  inspired // 我有启发
  resonate // 感同身受
  willTry // 值得尝试
}

/// Third-party health integration (design _5).
enum HealthProvider {
  appleHealth
  garmin
  oura
}

/// Source platform for imported health data.
enum HealthDataSource {
  appleHealth
  huaweiHealth
  xiaomiHealth
  samsungHealth
  googleFit
  oppoHealth
  manual
}

/// Type of health metric stored in HealthRecord.
enum HealthMetricType {
  steps
  heartRate
  restingHR
  sleepAnalysis
  workout
  weight
  bloodPressure
  bloodOxygen
  calories
  distance
  hrv
  stress
  mindfulSession
  flightsClimbed
  respiratoryRate
}

/// Status of a health data import job.
enum ImportStatus {
  processing
  completed
  failed
}

enum ConnectionStatus {
  connected
  disconnected
}

enum RedemptionStatus {
  pending
  fulfilled
  cancelled
}

/// Action type that can earn credits.
enum CreditAction {
  dailyCheckin       // 每日签到/对话
  habitComplete      // 完成一个习惯目标
  allHabitsComplete  // 每日所有目标全部完成 (bonus)
  moodCheckin        // 记录情绪打卡
  streakWeekly       // 连续7天完成目标 (streak bonus)
  mindfulness        // 完成正念练习
  postPublish        // 发布一篇文章
  postLiked          // 文章被点赞
  redemption         // 兑换商品 (negative)
  adminAdjust        // 管理员手动调整
}

/// Direction of a credit transaction.
enum CreditDirection {
  earn
  spend
}

/// Status of a friendship.
enum FriendshipStatus {
  pending   // 已发送，等待对方确认
  accepted  // 双方已是好友
  blocked   // 被屏蔽
}

/// Shareable content types for friend permissions.
enum ShareableContent {
  weeklyReport   // 周报
  monthlyReport  // 月报
  insights       // AI 洞察
  goals          // 习惯目标进度
  moodHistory    // 情绪记录
  posts          // 发布的文章
}

/// Period type for pre-computed reports.
enum PeriodType {
  weekly
  monthly
}

/// Category for AI-generated insights.
enum InsightType {
  pattern    // 新发现的模式
  prediction // 风险预警/趋势预测
  correlation // 正向/负向关联
  milestone  // 里程碑/成就
}

/// Meal type for dietary logs.
enum MealType {
  breakfast
  lunch
  dinner
  snack
}

/// How the user's meal was prepared / sourced.
enum CookingMethod {
  home_cooked
  takeout
  cafeteria
}

// ---------------------------------------------------------------------------
// Core
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  gender       Gender?
  birthday     DateTime? @db.Date
  heightCm     Int?
  weightKg     Float?
  targetWeightKg      Float?
  targetBodyFatPct    Float?
  dailyActiveCalories Int?
  dailyExerciseMinutes Int?
  dailyStepGoal       Int?
  dailyActiveHours    Float?
  memberSince  DateTime  @default(now())

  // Preferences (design _5)
  notificationsEnabled Boolean @default(true)
  // Credit balance for the wellness shop (design _6)
  credits              Int     @default(0)

  primaryGoal  GoalType?
  primaryGoals String[] @default([])
  /// AI companion personality role: gentle | coach | sage
  agentRole   String?
  /// Showcase users have their Memory data publicly visible as demos.
  isShowcase  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moodCheckins      MoodCheckin[]
  goals             Goal[]
  habitCompletions  HabitCompletion[]
  chatSessions      ChatSession[]
  memories          Memory[]
  healthConnections HealthConnection[]
  redemptions       Redemption[]
  reports           Report[]
  insights          Insight[]
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  postFavorites     PostFavorite[]
  commentLikes      CommentLike[]
  commentFavorites  CommentFavorite[]
  persona           UserPersona?
  notifications     Notification[]
  creditTransactions CreditTransaction[]
  healthImports      HealthImport[]
  healthRecords      HealthRecord[]

  // Health profile & plans
  healthProfile   UserHealthProfile?
  healthPlans     HealthPlan[]
  dietaryLogs     DietaryLog[]

  // Friend system
  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")
  friendPermissions      FriendPermission[] @relation("PermissionOwner")
  permissionsGrantedToMe FriendPermission[] @relation("PermissionFriend")

  // Family system
  familyMemberships FamilyMember[]
  familyAlerts      FamilyAlert[]

  @@map("users")
}

model Notification {
  id          String               @id @default(cuid())
  userId      String
  title       String
  body        String
  source      String?
  actionUrl   String?
  metadata    Json?
  priority    NotificationPriority @default(normal)
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, deliveredAt, createdAt])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

enum NotificationPriority {
  normal
  urgent
}

// ---------------------------------------------------------------------------
// Friend system
// ---------------------------------------------------------------------------

/// A friendship between two users. Always stored once per pair (requester → addressee).
/// Status transitions: pending → accepted/blocked. Deleting = unfriend.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  /// One friendship record per pair.
  @@unique([requesterId, addresseeId])
  /// Quick lookup: "all friendships involving user X"
  @@index([addresseeId, status])
  @@map("friendships")
}

/// Per-friend permission: what content the owner allows a specific friend to view.
/// Default: no permissions. Each row explicitly grants one content type.
model FriendPermission {
  id        String           @id @default(cuid())
  ownerId   String           // 被查看方（内容拥有者）
  friendId  String           // 查看方（好友）
  content   ShareableContent // 被允许查看的内容类型

  createdAt DateTime @default(now())

  owner  User @relation("PermissionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friend User @relation("PermissionFriend", fields: [friendId], references: [id], onDelete: Cascade)

  /// Each content type only granted once per friend pair.
  @@unique([ownerId, friendId, content])
  @@index([ownerId, friendId])
  @@map("friend_permissions")
}

// ---------------------------------------------------------------------------
// User Persona — Alice Agent Loop four cognitive dimensions
// ---------------------------------------------------------------------------

model UserPersona {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  identity    Json @default("{}")
  behavior    Json @default("{}")
  expression  Json @default("{}")
  preferences Json @default("{}")

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_personas")
}

// ---------------------------------------------------------------------------
// User Health Profile — structured health & lifestyle data collected during onboarding
// ---------------------------------------------------------------------------

model UserHealthProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Diet & allergies
  dietaryPreference   String?  // omnivore, vegetarian, vegan, keto, etc.
  foodAllergies       String[] @default([])
  foodIntolerances    String[] @default([])
  tastePreferences    String[] @default([]) // e.g. spicy, sweet, light
  dislikedFoods       String[] @default([])

  // Health & exercise constraints
  medicalConditions   String[] @default([])
  medications         String[] @default([])
  exerciseConstraints String[] @default([]) // injuries, limitations

  // Lifestyle (key factors for dietary recommendations)
  occupationType      String?  // sedentary, light, moderate, heavy
  workSchedule        String?  // day, night, shift, flexible
  cookingSkill        String?  // beginner, intermediate, advanced
  cookingFrequency    String?  // daily, few_times_week, rarely

  hasWearable         Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("user_health_profiles")
}

// ---------------------------------------------------------------------------
// Dietary Log — automatic & explicit meal records with AI evaluation
// ---------------------------------------------------------------------------

model DietaryLog {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  mealType         MealType
  logDate          DateTime      @db.Date
  loggedAt         DateTime      @default(now())

  rawInput         String        // User's original description
  parsedFoods      Json?         // [{ name, amount, unit, estimatedCalories, nutrients: { protein, carb, fat } }]
  totalCalories    Float?

  cookingMethod    CookingMethod?
  location         String?       // home, office, restaurant, commute

  // AI evaluation
  aiEvaluation     Json?         // { score, feedback, suggestions, nutritionBalance }

  // Wearable snapshot at time of logging
  wearableSnapshot Json?         // { steps, activeCalories, sleepScore }

  @@index([userId, logDate])
  @@index([userId, mealType, logDate])
  @@map("dietary_logs")
}

// ---------------------------------------------------------------------------
// Health Plan — AI-generated personalized plan (weight-loss, etc.)
// ---------------------------------------------------------------------------

model HealthPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  planData    Json     // { calorieTarget, macroSplit, mealStructure, exercisePlan, principles }
  planText    String?  // Human-readable plan text
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isActive])
  @@map("health_plans")
}

/// A daily emotional check-in (design _1 mood selection).
model MoodCheckin {
  id        String   @id @default(cuid())
  userId    String
  mood      Mood
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("mood_checkins")
}

// ---------------------------------------------------------------------------
// Goals & habits (design _4 goal tracking)
// ---------------------------------------------------------------------------

model Goal {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  icon        String? // Material Symbols icon name
  cadence     HabitCadence @default(daily)
  sortOrder   Int          @default(0)
  archived    Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@index([userId, archived])
  @@map("goals")
}

/// One completion record for a goal/habit on a given day.
model HabitCompletion {
  id          String   @id @default(cuid())
  goalId      String
  userId      String
  completedAt DateTime @default(now())
  /// Normalized day (UTC midnight) the completion counts toward; enables
  /// one-completion-per-day uniqueness and streak queries.
  forDate     DateTime @db.Date

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, forDate])
  @@index([userId, forDate])
  @@map("habit_completions")
}

// ---------------------------------------------------------------------------
// Chat (design 10 — pi-ai backed conversation)
// ---------------------------------------------------------------------------

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, pinned, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id           String   @id @default(cuid())
  sessionId    String
  role         ChatRole
  content      String
  /// URL to uploaded image (e.g. /api/assets/chat/xxx.jpg)
  imageUrl     String?  @map("image_url")
  /// Optional reasoning/thinking trace kept separate from the visible content.
  reasoning      String?
  /// JSON-serialized ToolCallInfo[] for display in the thinking section.
  toolCallsJson  String?
  /// Token usage / model metadata returned by the provider.
  model        String?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// ---------------------------------------------------------------------------
// Discover posts (blog/community — evolved from Journey)
// ---------------------------------------------------------------------------

model Post {
  id           String          @id @default(cuid())
  authorId     String
  title        String
  /// Short excerpt or pull-quote displayed on cards.
  excerpt      String?
  /// Full markdown/rich-text body.
  body         String
  category     JourneyCategory
  categoryIcon String?
  coverImage   String?
  readMinutes  Int             @default(5)
  published    Boolean         @default(true)
  publishedAt  DateTime        @default(now())
  /// View count for popularity sorting.
  viewCount    Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
  favorites PostFavorite[]

  @@index([category, published, publishedAt])
  @@index([authorId])
  @@map("posts")
}

model Comment {
  id       String  @id @default(cuid())
  postId   String
  authorId String
  /// Optional parent comment for threaded replies.
  parentId String?
  body     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")
  likes    CommentLike[]
  favorites CommentFavorite[]

  @@index([postId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model Like {
  id       String @id @default(cuid())
  postId   String
  authorId String

  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([postId, authorId])
  @@index([postId])
  @@map("likes")
}

model PostFavorite {
  id       String @id @default(cuid())
  postId   String
  authorId String

  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([postId, authorId])
  @@index([postId])
  @@map("post_favorites")
}

model VectorDocument {
  id        String                 @id @default(dbgenerated("gen_random_uuid()::text"))
  namespace String
  sourceId  String                 @map("source_id")
  userId    String?                @map("user_id")
  title     String?
  content   String
  metadata  Json                   @default("{}")
  embedding Unsupported("vector(1024)")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  @@unique([namespace, sourceId], map: "vector_documents_namespace_source_id_key")
  @@index([namespace], map: "vector_documents_namespace_idx")
  @@map("vector_documents")
}

model CommentLike {
  id        String @id @default(cuid())
  commentId String
  authorId  String

  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([commentId, authorId])
  @@index([commentId])
  @@map("comment_likes")
}

model CommentFavorite {
  id        String @id @default(cuid())
  commentId String
  authorId  String

  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([commentId, authorId])
  @@index([commentId])
  @@map("comment_favorites")
}

// ---------------------------------------------------------------------------
// Memory & reflections (design _2)
// ---------------------------------------------------------------------------

model Memory {
  id        String   @id @default(cuid())
  userId    String
  /// Free-form reflection note the user records.
  note      String?
  /// The storyline/prompt this memory responds to, if any.
  prompt    String?
  /// Origin of this memory: manual, chat, post-like, post-favorite, post-comment, etc.
  source    String?
  sourceId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions MemoryReaction[]

  @@index([userId, createdAt])
  @@index([userId, source, createdAt])
  @@map("memories")
}

model MemoryReaction {
  id       String       @id @default(cuid())
  memoryId String
  type     ReactionType

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([memoryId, type])
  @@map("memory_reactions")
}

// ---------------------------------------------------------------------------
// Health connections (design _5)
// ---------------------------------------------------------------------------

model HealthConnection {
  id          String           @id @default(cuid())
  userId      String
  provider    HealthProvider
  status      ConnectionStatus @default(disconnected)
  connectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("health_connections")
}

// ---------------------------------------------------------------------------
// Health data import (imported from Apple Health, Huawei, Samsung, etc.)
// ---------------------------------------------------------------------------

/// A single health data import job (one uploaded file).
model HealthImport {
  id          String           @id @default(cuid())
  userId      String
  source      HealthDataSource
  fileName    String
  fileSize    Int              // bytes
  status      ImportStatus     @default(processing)
  recordCount Int              @default(0)
  /// Data time range
  dataFrom    DateTime?
  dataTo      DateTime?
  /// Error message if failed
  error       String?
  /// Per-metric counts: { steps: 1200, heartRate: 5000, ... }
  summary     Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  records HealthRecord[]

  @@index([userId, createdAt])
  @@map("health_imports")
}

/// A single health measurement record (normalized from any source).
model HealthRecord {
  id         String           @id @default(cuid())
  userId     String
  source     HealthDataSource
  metric     HealthMetricType
  value      Float
  unit       String           // count, bpm, kg, kcal, min, km, %, ms...
  startDate  DateTime
  endDate    DateTime
  /// Extra data (sleep stage, workout type, systolic/diastolic, etc.)
  metadata   Json?
  /// Original source device/app name
  sourceName String?
  importId   String?

  createdAt  DateTime @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  import     HealthImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([userId, metric, startDate])
  @@index([userId, startDate])
  @@index([importId])
  @@map("health_records")
}

// ---------------------------------------------------------------------------
// Wellness shop (design _6)
// ---------------------------------------------------------------------------

model Product {
  id           String  @id @default(cuid())
  name         String
  description  String
  image        String?
  priceCredits Int
  available    Boolean @default(true)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions Redemption[]

  @@map("products")
}

model Redemption {
  id           String           @id @default(cuid())
  userId       String
  productId    String
  creditsSpent Int
  status       RedemptionStatus @default(pending)
  createdAt    DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([userId, createdAt])
  @@map("redemptions")
}

// ---------------------------------------------------------------------------
// Credit system (earning rules + transaction ledger)
// ---------------------------------------------------------------------------

/// Defines how credits are earned. Each rule maps an action to a reward amount.
/// Rules are displayed to users in the shop for transparency.
model CreditRule {
  id          String       @id @default(cuid())
  action      CreditAction @unique
  /// Human-readable name displayed in the UI.
  name        String
  /// Detailed description of how to earn this credit.
  description String
  /// Credits awarded per occurrence.
  amount      Int
  /// Maximum times this action can earn credits per day (0 = unlimited).
  dailyCap    Int          @default(0)
  /// Icon name (Material Symbols) for display.
  icon        String?
  /// Whether this rule is currently active.
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("credit_rules")
}

/// Immutable ledger of all credit changes (earnings and spendings).
model CreditTransaction {
  id        String          @id @default(cuid())
  userId    String
  action    CreditAction
  direction CreditDirection
  amount    Int
  /// Running balance after this transaction.
  balance   Int
  /// Optional reference to the entity that triggered this transaction.
  refId     String?
  /// Human-readable note.
  note      String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, action, createdAt])
  @@map("credit_transactions")
}

// ---------------------------------------------------------------------------
// Reports & Insights (Memory page — pre-computed wellness reports)
// ---------------------------------------------------------------------------

/// Pre-computed periodic report snapshot. Generated by backend/AI jobs.
/// `data` is a flexible JSON payload containing aggregated metrics, charts,
/// achievements, etc. — content varies per user based on available data.
model Report {
  id          String     @id @default(cuid())
  userId      String
  periodType  PeriodType
  /// Start of the period (Monday for weekly, 1st for monthly), UTC midnight.
  periodStart DateTime   @db.Date
  /// End of the period (exclusive), UTC midnight.
  periodEnd   DateTime   @db.Date
  /// Version number for the same period (1 = first generation, increments on regenerate).
  version     Int        @default(1)
  /// JSON payload with the report's pre-computed content:
  /// {
  ///   moodEmojis?: string[],        // e.g. ["😊","😐","😴",...]
  ///   stats?: { label, value, change, positive }[],
  ///   sleepData?: number[],          // hours per day
  ///   highlights?: { icon, label, value }[],
  ///   achievements?: { icon, title, date }[],
  ///   overallScore?: number,         // 0-100
  /// }
  data        Json
  /// Optional summary text (can be AI-generated narrative).
  summary     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  insights Insight[]

  @@unique([userId, periodType, periodStart, version])
  @@index([userId, periodType, periodStart])
  @@map("reports")
}

/// AI-generated insight attached to a user, optionally linked to a specific report.
model Insight {
  id        String      @id @default(cuid())
  userId    String
  reportId  String?
  type      InsightType
  title     String
  content   String
  /// Flexible metadata: confidence score, related factors, severity, etc.
  metadata  Json?
  /// Whether the user has dismissed/acknowledged this insight.
  dismissed Boolean     @default(false)

  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([reportId])
  @@map("insights")
}

// ---------------------------------------------------------------------------
// Family system (远程健康关怀)
// ---------------------------------------------------------------------------

/// 家庭角色
enum FamilyRole {
  owner     // 创建者/管理员
  caregiver // 关怀者（子女、配偶等）——收到被关怀者的预警通知
  member    // 被关怀者（老人等）——出问题时通知关怀者
  observer  // 普通成员——可查看数据但不参与预警
}

/// 预警灵敏度级别
enum AlertLevel {
  low    // 仅严重异常
  medium // 中等敏感度（默认）
  high   // 高度关注
}

/// 家庭
model Family {
  id          String   @id @default(cuid())
  name        String
  description String?
  inviteCode  String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members FamilyMember[]
  alerts  FamilyAlert[]

  @@map("families")
}

/// 家庭成员
model FamilyMember {
  id         String     @id @default(cuid())
  familyId   String
  userId     String
  role       FamilyRole @default(member)
  nickname   String?    // 家庭中的称呼（如"爷爷"、"小明"）
  alertLevel AlertLevel @default(medium)

  /// 共享设置
  shareHealthData  Boolean @default(true)  // 健康数据对家庭可见
  shareAlerts      Boolean @default(true)  // 异常时通知家庭
  shareMoodHistory Boolean @default(false) // 情绪记录对家庭可见

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@map("family_members")
}

/// 家庭健康预警记录
model FamilyAlert {
  id           String   @id @default(cuid())
  familyId     String
  sourceUserId String
  /// 预警类型: health-anomaly | chat-concern | device-alert | missed-checkin
  alertType    String
  /// 严重程度: info | warning | critical
  severity     String
  title        String
  content      String
  metadata     Json?
  resolved     Boolean  @default(false)
  resolvedBy   String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  family     Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sourceUser User   @relation(fields: [sourceUserId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
  @@index([sourceUserId, createdAt])
  @@map("family_alerts")
}
